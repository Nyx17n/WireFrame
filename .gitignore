# ============================================================================
# TennoFrame v2 — Fichier .gitignore strict (Electron + React + TypeScript)
# RÈGLE ABSOLUE : Aucun binaire, exécutable, archive ou artefact de build
# ne doit jamais être commité dans Git.
# ============================================================================

# Dépendances Node.js
node_modules/
.pnp
.pnp.js
.npm/
.pnpm-store/

# Dossiers de build, bundles & livrables Electron (electron-vite / electron-builder)
dist/
dist-electron/
out/
build/
release/
releases/

# Exécutables, bibliothèques compilées, installateurs & archives (INTERDITS DANS GIT)
*.exe
*.exe.bak
*.dll
*.so
*.dylib
*.msi
*.msix
*.appx
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.snap
*.nupkg
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.rar
*.blockmap

# Fichiers de compilation C# / Python hérités (sécurité anti-régression)
__pycache__/
*.py[cod]
.venv/
venv/
bin/
obj/
*.pdb

# Cache d'outils, TypeScript & tests
*.tsbuildinfo
.eslintcache
.stylelintcache
.vite/
.cache/
coverage/
*.lcov
playwright-report/
test-results/

# Variables d'environnement & secrets locaux
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12
*.key

# Journaux, sauvegardes & fichiers temporaires
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.bak
*.tmp
*.temp
~*

# Système d'exploitation (Windows / macOS / Linux)
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# Éditeurs & IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo

