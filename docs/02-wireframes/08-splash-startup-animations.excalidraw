    {
      "id": "mech-exp-b",
      "type": "text",
      "x": 664,
      "y": 242,
      "width": 242,
      "height": 323,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
